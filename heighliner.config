dockerfile 'Dockerfile'

# weaver preview binds 0.0.0.0:4567
expose '4567'
type :http

# weaver preview re-renders on every request, so with `heighliner attach`
# edits to these show up without a rebuild
attach_mount 'source', '/app/source'
attach_mount 'css', '/app/css'
attach_mount 'js', '/app/js'
