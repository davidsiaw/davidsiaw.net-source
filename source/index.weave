center_page "", "Welcome to davidsiaw.net", theme: "dark" do
	request_css "css/front.css"

	links = [
		{ href: "https://davidsiaw.github.io", icon: :pencil, title: "blog", sub: "davidsiaw.github.io" },
		{ href: "https://resume.davidsiaw.net", icon: :file_text_o, title: "résumé", sub: "resume.davidsiaw.net" },
		{ href: "https://github.com/davidsiaw", icon: :github, title: "github", sub: "github.com/davidsiaw" },
		{ href: "https://davidsiaw.net/playground", icon: :flask, title: "playground", sub: "small experiments" },
	]

	div class: "front" do
		h1 "central dogma", class: "front-title"
		p "davidsiaw.net", class: "front-subtitle"

		div class: "front-grid" do
			links.each do |link|
				a href: link[:href], class: "front-card" do
					icon link[:icon]
					span link[:title], class: "front-card-title"
					span link[:sub], class: "front-card-sub"
				end
			end
		end
	end
end
