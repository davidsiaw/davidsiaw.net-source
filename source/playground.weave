center_page "", "david's playground", theme: "dark" do
	request_css "css/front.css"

	div class: "front" do
		a "← davidsiaw.net", href: "/", class: "front-back"
		h1 "playground", class: "front-title"
		p "small experiments", class: "front-subtitle"

		div class: "front-grid" do
			a href: "/playground/bitrep", class: "front-card" do
				icon :th
				span "bit representation", class: "front-card-title"
				span "integers & floats, bit by bit", class: "front-card-sub"
			end

			a href: "/playground/elements", class: "front-card" do
				icon :flask
				span "periodic table", class: "front-card-title"
				span "all 118 elements", class: "front-card-sub"
			end
		end
	end
end
