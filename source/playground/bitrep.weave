nonnav_page "", "bitrep", theme: "dark" do

	request_css 'css/bitrep.css'
	request_js 'js/bitrep.js'

	# bit index where the exponent starts, per width (mirrors expobit in js/bitrep.js)
	mantissa_bits = { 8 => 3, 16 => 10, 24 => 16, 32 => 23, 64 => 52 }
	ieee_names = { 16 => "half", 32 => "single", 64 => "double" }
	examples = ["42", "-1", "3.14159", "0.1", "65504.0", "Infinity"]

	row do
		col 12 do
			div class: "bitrep" do
				a "← playground", href: "/playground", class: "bitrep-back"
				h1 "bit representation", class: "bitrep-title"
				p "Type an integer to see its two's complement bits, or a decimal to see it as a float at each width.", class: "bitrep-lede"

				form id: "form0", class: "bitrep-form", onsubmit: "changed(); return false;" do
					input type: "text", name: "num", value: "3.14159", class: "bitrep-input",
						autocomplete: "off", spellcheck: "false", "aria-label": "number",
						oninput: "changed()"
				end

				div class: "bitrep-examples" do
					span "try", class: "bitrep-examples-label"
					examples.each do |ex|
						button ex, type: "button", class: "bitrep-example",
							onclick: "document.getElementById('form0').elements['num'].value='#{ex}'; changed();"
					end
				end

				div class: "bitrep-legend" do
					span "sign", class: "bitrep-key sign"
					span "exponent", class: "bitrep-key exponent"
					span "mantissa", class: "bitrep-key mantissa"
				end

				[8, 16, 24, 32, 64].each do |sz|
					mant = mantissa_bits[sz]
					expo = sz - 1 - mant

					div class: "bitrep-card" do
						div class: "bitrep-card-head" do
							span "#{sz}-bit", class: "bitrep-width"
							span [ieee_names[sz], "1 · #{expo} · #{mant}"].compact.join(" · "), class: "bitrep-format"
						end

						# 32 bits per line, grouped by byte
						(0...sz).map { |x| sz - 1 - x }.each_slice(32) do |line|
							div class: "bitrep-bits" do
								line.each_slice(8) do |byte|
									div class: "bitrep-byte" do
										byte.each do |i|
											field = if i == sz - 1 then "sign" elsif i >= mant then "exponent" else "mantissa" end
											div class: "bitrep-bit #{field}" do
												span "#{i}", id: "label#{sz}_#{i}", class: "bitrep-index"
												span "0", id: "b#{sz}_#{i}", class: "bitrep-value"
											end
										end
									end
								end
							end
						end

						div "", id: "info#{sz}", class: "bitrep-info"
					end
				end
			end
		end
	end

	on_page_load "changed();"
end
